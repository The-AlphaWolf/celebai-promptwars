# Server-side only. Never prefix with VITE_ (that would bundle it into the browser).
# Get a key at https://aistudio.google.com/ . Without it the app runs on the deterministic planning engine.
GEMINI_API_KEY=
# Optional
GEMINI_MODEL=gemini-2.5-flash
PORT=8080
# Set to 1 behind exactly one reverse proxy (e.g. Cloud Run) so rate limiting sees real client IPs.
TRUST_PROXY=
