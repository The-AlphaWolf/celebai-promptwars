{
  "name": "celebai-event-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "canvas-confetti": "^1.9.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "description": "CelebAI: event planning assistant for weddings, birthdays and community events (PromptWars Challenge 5).",
  "homepage": "https://the-alphawolf.github.io/celebai-promptwars/",
  "repository": {
    "type": "git",
